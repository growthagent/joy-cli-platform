#!/usr/bin/env roc
app [main!] {
	pf: platform "https://github.com/niclas-ahden/basic-cli/releases/download/0.32.0/3MnQnCrtfe6XS5qx58MnAGU6iWk8i1N24MYfoejcWeax.tar.zst",
	weaver: "https://github.com/lukewilliamboswell/weaver/releases/download/0.10.2/7CdYzjBAJmprmnK45oTpmH6BXt76ZASN2Ck5uZQEoWsK.tar.zst",
}

import pf.Path
import pf.Stdout
import weaver.Cli
import weaver.Opt
import Cargo
import CommandLine
import Files
import Licenses
import Process
import Targets
import Text

## Generates the third-party notices for everything linked into the platform
## hosts.
##
## The hand-written preamble of THIRD_PARTY_LICENSES.md is kept. Everything
## after its marker is regenerated from `cargo metadata` for every Roc target,
## the license files and source copyright lines of each linked package, and the
## prebuilt native inputs recorded in licenses/native-inputs.json.
##
## Run it from the repository root after changing Cargo.lock, the Rust
## toolchain or a prebuilt native input:
##
##     roc scripts/third_party_notices.roc
##
## `--check` changes nothing and fails when the committed notices are stale.
## `roc test scripts/third_party_notices.roc` runs the tests at the bottom.
main! : _ => Try({}, _)
main! = |raw_args| {
	check = CommandLine.read!(cli, raw_args)?
	Process.finish!(run!(check))
}

cli = Cli.finish_without_validating(Opt.flag({ short: "", long: "check", help: "Fail when the notices are stale instead of writing them." }), CommandLine.config({ name: "third_party_notices.roc", description: "Generate the third-party notices." }))

notices_file : Str
notices_file = "THIRD_PARTY_LICENSES.md"

marker : Str
marker = "<!-- Everything below is generated by scripts/third_party_notices.roc. Do not edit it by hand. -->"

## Every Roc target and the Rust target its host is built for.
rust_targets : List((Str, Str))
rust_targets = Targets.all

## The folders under platform/targets whose files are prebuilt inputs: the
## Unix targets and the macOS link stubs.
native_folders : List(Str)
native_folders = Targets.unix.map(|(roc_target, _)| roc_target).append("macos-sysroot")

## Built from Cargo sources, so the Cargo section covers them.
generated_inputs : List(Str)
generated_inputs = ["libhost.a"]

## Which license a package offered under a choice of them is used under: the
## first of these it offers. MIT comes first because its text is short and
## most packages offer it.
preference : List(Str)
preference = [
	"MIT",
	"Apache-2.0",
	"ISC",
	"Unlicense",
	"CC0-1.0",
	"BSD-3-Clause",
	"BSD-2-Clause",
	"Zlib",
	"Unicode-3.0",
	"UPL-1.0",
	"CDLA-Permissive-2.0",
	"Apache-2.0 WITH LLVM-exception",
]

## The source files whose headers are searched for copyright statements.
source_suffixes : List(Str)
source_suffixes = [".rs", ".c", ".cc", ".cpp", ".h", ".hpp", ".inl", ".S", ".asm", ".pl"]

## How far into a source file its header is looked for, in lines.
header_lines : U64
header_lines = 100

run! : Bool => Try({}, [Failed(Str)])
run! = |check| {
	current = Files.read_text!(notices_file)?
	pkgs = cargo_packages!()?
	components = native_components!()?
	rust = rust_version(Files.read_text!("rust-toolchain.toml")?)?
	expected = with_generated(current, render(pkgs, components, rust))?
	if !check {
		Path.utf8(notices_file).write_utf8!(expected) ? |err| Failed("could not write ${notices_file}: ${Str.inspect(err)}")
		return Ok({})
	}
	if current == expected {
		Ok({})
	} else {
		Stdout.line!(first_difference(current, expected)) ?? {}
		Err(Failed("${notices_file} is stale. Run `roc scripts/third_party_notices.roc`"))
	}
}

## The committed notices with everything after the marker replaced.
with_generated : Str, Str -> Try(Str, [Failed(Str)])
with_generated = |current, generated|
	match current.split_first(marker) {
		Ok({ before, .. }) => Ok("${before}${generated}")
		Err(_) => Err(Failed("${notices_file} is missing the generated-section marker"))
	}

## The first line where the two texts part, for `--check`.
first_difference : Str, Str -> Str
first_difference = |committed, generated| {
	ours = committed.split_on("\n")
	theirs = generated.split_on("\n")
	at = first_unequal(ours, theirs, 0)
	show = |lines, sign| Str.join_with(lines.drop_first(at).take_first(3).map(|line| "${sign} ${line}"), "\n")
	"First difference at line ${(at + 1).to_str()}, committed then generated:\n${show(ours, "-")}\n${show(theirs, "+")}"
}

first_unequal : List(Str), List(Str), U64 -> U64
first_unequal = |a, b, at|
	match (a, b) {
		([x, .. as xs], [y, .. as ys]) if x == y => first_unequal(xs, ys, at + 1)
		_ => at
	}

# Cargo packages

## A linked package with what its notices need.
Gathered : { name : Str, version : Str, license : Str, roc_targets : List(Str), texts : List((Str, Str)), copyrights : List(Str) }

## Every package linked into a host, with the Roc targets that link it.
cargo_packages! : () => Try(List(Gathered), [Failed(Str)])
cargo_packages! = || {
	var $linked = []
	for (roc_target, rust_target) in rust_targets {
		metadata = Cargo.metadata!(["--locked", "--filter-platform", rust_target])?
		for pkg in Cargo.linked(metadata, WithoutRoot) {
			$linked = $linked.append((pkg, roc_target))
		}
	}
	by_package = group_targets($linked).sort_with(|(a, _), (b, _)| then_compare(Files.compare(a.name, b.name), a.version, b.version))
	by_package.fold_try!(
		[],
		|gathered, (pkg, roc_targets)| {
			match pkg.source {
				Err(Null) => return Err(Failed("Local path dependency ${pkg.name} needs a reviewed notice"))
				Ok(_) => {}
			}
			license = pkg.license ?? ""
			Licenses.check(pkg.name, pkg.version, license)?
			dir = Files.parent_of(pkg.manifest_path)
			files = Files.files_under!(dir)?
			texts = license_texts!(pkg, dir, files)?
			copyrights = source_copyrights!(dir, files)?
			Ok(gathered.append({ name: pkg.name, version: pkg.version, license, roc_targets, texts, copyrights }))
		},
	)
}

## Each package once, in the order first seen, with every target that links it.
group_targets : List((Cargo.Package, Str)) -> List((Cargo.Package, List(Str)))
group_targets = |pairs|
	pairs.fold(
		[],
		|groups, (pkg, target)|
			if groups.any(|(seen, _)| seen.id == pkg.id) {
				groups.map(|(seen, roc_targets)| if (seen.id == pkg.id) (seen, roc_targets.append(target)) else (seen, roc_targets))
			} else {
				groups.append((pkg, [target]))
			},
	)

## The ways an SPDX expression can be met, each the licenses one way needs:
## `A OR B` is two ways, `A AND B` one way that needs both, and the old
## `A/B` means `A OR B`.
license_choices : Str -> List(List(Str))
license_choices = |expression| {
	(choices, _) = or_choices(Licenses.tokens(expression))
	choices
}

or_choices : List(Str) -> (List(List(Str)), List(Str))
or_choices = |tokens| {
	(first, rest) = and_choices(tokens)
	match rest {
		["OR", .. as more] => {
			(others, after) = or_choices(more)
			(first.concat(others), after)
		}
		["/", .. as more] => {
			(others, after) = or_choices(more)
			(first.concat(others), after)
		}
		_ => (first, rest)
	}
}

and_choices : List(Str) -> (List(List(Str)), List(Str))
and_choices = |tokens| {
	(first, rest) = single_choices(tokens)
	match rest {
		["AND", .. as more] => {
			(others, after) = and_choices(more)
			(first.join_map(|a| others.map(|b| a.concat(b))), after)
		}
		_ => (first, rest)
	}
}

single_choices : List(Str) -> (List(List(Str)), List(Str))
single_choices = |tokens|
	match tokens {
		["(", .. as more] => {
			(inner, after) = or_choices(more)
			match after {
				[")", .. as rest] => (inner, rest)
				_ => (inner, after)
			}
		}
		[name, "WITH", exception, .. as rest] => ([["${name} WITH ${exception}"]], rest)
		[name, .. as rest] => ([[name]], rest)
		[] => ([], [])
	}

## The licenses a package is used under: of the ways its expression offers,
## the one with the most preferred licenses whose texts the package ships.
elect : Str, List(Str) -> Try(List(Str), [NoChoice])
elect = |expression, shipped|
	license_choices(expression)
		.keep_if(|choice| !choice.is_empty() and choice.all(|license| shipped.contains(license)))
		.sort_with(|a, b| compare_u64(choice_cost(a), choice_cost(b)))
		.first()
		.map_err(|_| NoChoice)

choice_cost : List(Str) -> U64
choice_cost = |choice| {
	worst = choice.fold(
		0,
		|most, license| {
			rank = preference.find_first_index(|p| p == license) ?? preference.len()
			if (rank > most) rank else most
		},
	)
	worst * 100 + choice.len()
}

## The licenses whose full text a license file holds, told by a phrase each
## of those texts has.
licenses_in : Str -> List(Str)
licenses_in = |text| {
	t = squeeze(text.with_ascii_lowercased())
	holds = |phrase| t.contains(phrase)
	llvm = holds("apache license") and holds("version 2.0") and holds("llvm exceptions")
	bsd = holds("redistribution and use in source and binary forms")
	found = [
		("Apache-2.0 WITH LLVM-exception", llvm),
		("Apache-2.0", !llvm and holds("apache license") and holds("version 2.0, january 2004")),
		("MIT", holds("permission is hereby granted, free of charge, to any person obtaining a copy")),
		("ISC", holds("permission to use, copy, modify, and/or distribute this software for any purpose") or holds("permission to use, copy, modify, and distribute this software for any purpose")),
		("Unlicense", holds("this is free and unencumbered software released into the public domain")),
		("CC0-1.0", holds("cc0 1.0 universal")),
		("BSD-3-Clause", bsd and holds("neither the name")),
		("BSD-2-Clause", bsd and !holds("neither the name")),
		("Zlib", holds("altered source versions must be plainly marked")),
		("Unicode-3.0", holds("unicode license v3")),
		("UPL-1.0", holds("universal permissive license")),
		("CDLA-Permissive-2.0", holds("community data license agreement - permissive - version 2.0")),
	]
	found.keep_if(|(_, present)| present).map(|(license, _)| license)
}

## The license files a package's notices print, and the licenses it is used
## under. Of a package offered under a choice of licenses, a file at the
## package's root is left out when every license it holds is one the
## expression offered and was not chosen. Every other file stays: one deeper
## in the package (a vendored component's own license), one that holds no
## license text this script knows (COPYRIGHT, NOTICE, custom terms), and every
## file when no way to meet the expression has all its texts.
used_texts : Str, List((Str, Str)) -> { used_under : Str, texts : List((Str, Str)) }
used_texts = |expression, texts| {
	shipped = texts.join_map(|(_, text)| licenses_in(text))
	match elect(expression, shipped) {
		Ok(chosen) => {
			offered = license_choices(expression).join_map(|choice| choice)
			kept = texts.keep_if(
				|(path, text)| {
					found = licenses_in(text)
					at_root = !path.contains("/")
					not_chosen = !found.is_empty() and found.all(|license| offered.contains(license) and !chosen.contains(license))
					!(at_root and not_chosen)
				},
			)
			{ used_under: Str.join_with(chosen, " AND "), texts: kept }
		}
		Err(NoChoice) => { used_under: expression, texts }
	}
}

## Every license file of a package, normalized and by name.
license_texts! : Cargo.Package, Str, List(Str) => Try(List((Str, Str)), [Failed(Str)])
license_texts! = |pkg, dir, files| {
	texts = license_candidates(files, pkg.license_file).fold_try!(
		[],
		|found, relative| {
			text = normalize(Files.read_text!("${dir}/${relative}")?)
			Ok(if (text.is_empty()) found else found.append((relative, text)))
		},
	)?
	require_texts(pkg.name, pkg.version, texts)
}

require_texts : Str, Str, List((Str, Str)) -> Try(List((Str, Str)), [Failed(Str)])
require_texts = |name, version, texts|
	if texts.is_empty() {
		Err(Failed("No license files for ${name} ${version}"))
	} else {
		Ok(texts.sort_with(|(a, text_a), (b, text_b)| then_compare(Files.compare(a, b), text_a, text_b)))
	}

## The files of a package, by their path inside it, that are license texts:
## named like one anywhere in its source, and the `license_file` its
## manifest names.
license_candidates : List(Str), Try(Str, [Null]) -> List(Str)
license_candidates = |files, license_file| {
	named = files.keep_if(Licenses.is_license_file)
	match license_file {
		Ok(extra) if !named.contains(extra) => named.append(extra)
		_ => named
	}
}

## Copyright statements in the headers of a package's source files, which
## may name holders its license files leave out.
source_copyrights! : Str, List(Str) => Try(List(Str), [Failed(Str)])
source_copyrights! = |dir, files| {
	sources = files.keep_if(|relative| source_suffixes.contains(Files.suffix_of(Files.base_name(relative))))
	found = sources.fold_try!([], |all, relative| Ok(all.concat(copyright_paragraphs(Files.read_text!("${dir}/${relative}")?))))?
	Ok(Files.unique_sorted(found))
}

## The comment paragraphs at the start of a source file that speak of
## copyright or the public domain.
copyright_paragraphs : Str -> List(Str)
copyright_paragraphs = |source| {
	lines = source.replace_each("\r\n", "\n").replace_each("\r", "\n").split_on("\n").take_first(header_lines)
	header_paragraphs(lines).keep_if(
		|paragraph| {
			lowered = paragraph.with_ascii_lowercased()
			lowered.contains("copyright") or lowered.contains("public domain")
		},
	)
}

## Comment paragraphs, without their comment markers.
header_paragraphs : List(Str) -> List(Str)
header_paragraphs = |lines| {
	(done, open) = lines.fold(
		([], []),
		|(paragraphs, paragraph), line| {
			text = comment_text(line)
			if !text.is_empty() {
				(paragraphs, paragraph.append(text))
			} else if paragraph.is_empty() {
				(paragraphs, paragraph)
			} else {
				(paragraphs.append(Str.join_with(paragraph, "\n")), [])
			}
		},
	)
	if (open.is_empty()) done else done.append(Str.join_with(open, "\n"))
}

## What a comment line says, or nothing for a line that is not a comment.
## The comment leaders are those of the scanned languages, assembler `@` and
## `;` included. A `#` is not one before `!`, `[` or a C preprocessor word,
## so shebangs, Rust attributes and directives are left out.
comment_text : Str -> Str
comment_text = |line| {
	bytes = Text.drop_leading(line.to_utf8(), Text.is_space)
	rest =
		match bytes {
			[a, b, .. as more] if a == '/' and b == '/' => Ok(drop_optional(Text.drop_leading(more, |c| c == '/'), '!'))
			[a, b, .. as more] if a == '/' and b == '*' => Ok(drop_optional(Text.drop_leading(more, |c| c == '*'), '!'))
			[a, .. as more] if a == '*' => Ok(drop_optional(Text.drop_leading(more, |c| c == '*'), '/'))
			[a, .. as more] if a == '@' => Ok(more)
			[a, .. as more] if a == ';' => Ok(Text.drop_leading(more, |c| c == ';'))
			[a, ..] if a == '#' => hash_comment(bytes)
			_ => Err(NotComment)
		}
	match rest {
		Ok(text) => drop_comment_end(Str.from_utf8_lossy(text)).trim()
		Err(NotComment) => ""
	}
}

## A run of `#` is a comment unless what follows it is a shebang, an
## attribute or a directive. Then a run of two or more still is one, as one
## `#` followed by the rest of the run.
hash_comment : List(U8) -> Try(List(U8), [NotComment])
hash_comment = |bytes| {
	after = Text.drop_leading(bytes, |c| c == '#')
	hashes = bytes.len() - after.len()
	if !is_directive(after) {
		Ok(after)
	} else if hashes > 1 {
		Ok(bytes.drop_first(1))
	} else {
		Err(NotComment)
	}
}

is_directive : List(U8) -> Bool
is_directive = |bytes| {
	rest = Text.drop_leading(bytes, Text.is_space)
	match rest {
		[c, ..] if c == '!' or c == '[' => True
		_ => {
			words = ["if", "ifdef", "ifndef", "elif", "else", "endif", "define", "undef", "include", "pragma", "error"]
			words.any(
				|word| {
					w = word.to_utf8()
					rest.starts_with(w)
						and (
							match rest.get(w.len()) {
								Ok(next) => !Text.is_word_byte(next)
								Err(_) => True
							}
						)
				},
			)
		}
	}
}

## A comment line without a closing `*/` and what follows it.
drop_comment_end : Str -> Str
drop_comment_end = |text| {
	trimmed = text.trim_end()
	if trimmed.ends_with("*/") {
		without_slash = trimmed.to_utf8().drop_last(1)
		Str.from_utf8_lossy(drop_trailing(without_slash, |c| c == '*'))
	} else {
		text
	}
}

# Prebuilt native inputs

Component : { name : Str, version : Str, license : Str, license_file : Str, upstream : Str, origin : Str, files : Dict(Str, Str) }

## A recorded prebuilt input, with its license text and its files by path.
Native : { name : Str, version : Str, license : Str, license_file : Str, upstream : Str, origin : Str, files : List((Str, Str)), text : Str }

## The recorded prebuilt inputs, after checking that they are the files we
## ship.
native_components! : () => Try(List(Native), [Failed(Str)])
native_components! = || {
	recorded : Try({ components : List(Component) }, _)
	recorded = Json.parse(Files.read_text!("licenses/native-inputs.json")?)
	components = (recorded ? |err| Failed("licenses/native-inputs.json is not what this script reads: ${Str.inspect(err)}")).components
	natives = components.fold_try!(
		[],
		|all, component| {
			text = Files.read_text!("licenses/${component.license_file}") ? |_| Failed("Missing license file for ${component.name}: ${component.license_file}")
			files = component.files.to_list().sort_with(|(a, _), (b, _)| Files.compare(a, b))
			Ok(all.append({ name: component.name, version: component.version, license: component.license, license_file: component.license_file, upstream: component.upstream, origin: component.origin, files, text }))
		},
	)?
	hashes = natives.join_map(|native| native.files).fold_try!([], |all, (path, _)| Ok(all.append((path, Files.sha256!(path).map_err(|_| Missing)))))?
	shipped = native_folders.fold_try!(
		[],
		|all, folder| {
			dir = "platform/targets/${folder}"
			if Path.utf8(dir).is_dir!() ?? False {
				Ok(all.concat(Files.files_under!(dir)?.map(|relative| "${dir}/${relative}")))
			} else {
				Ok(all)
			}
		},
	)?
	check_native(natives, hashes, shipped)?
	Ok(natives)
}

## Refuses a recorded input whose file is missing or changed, and a shipped
## file nobody recorded.
check_native : List(Native), List((Str, Try(Str, [Missing]))), List(Str) -> Try({}, [Failed(Str)])
check_native = |natives, hashes, shipped| {
	recorded = natives.join_map(|native| native.files)
	changed = recorded.find_first(|(path, expected)| hashes.find_first(|(hashed, _)| hashed == path).map_ok(|(_, actual)| actual != Ok(expected)) ?? True)
	match changed {
		Ok((path, _)) => Err(Failed("${path} does not match licenses/native-inputs.json. Record the new input's origin, hash and license"))
		Err(_) => {
			unrecorded = shipped.keep_if(|path| !generated_inputs.contains(Files.base_name(path)) and !recorded.any(|(known, _)| known == path))
			if unrecorded.is_empty() {
				Ok({})
			} else {
				Err(Failed("Prebuilt inputs without a provenance record: ${Str.join_with(Files.unique_sorted(unrecorded), ", ")}"))
			}
		}
	}
}

## The Rust version rust-toolchain.toml pins.
rust_version : Str -> Try(Str, [Failed(Str)])
rust_version = |toml|
	toml.split_on("\n").keep_oks(channel_of).first().map_err(|_| Failed("rust-toolchain.toml has no channel"))

channel_of : Str -> Try(Str, [NoChannel])
channel_of = |line| {
	if !line.starts_with("channel") {
		return Err(NoChannel)
	}
	assigned = line.drop_prefix("channel").trim_start()
	if !assigned.starts_with("=") {
		return Err(NoChannel)
	}
	quoted = assigned.drop_prefix("=").trim_start()
	if !quoted.starts_with("\"") {
		return Err(NoChannel)
	}
	match quoted.drop_prefix("\"").split_first("\"") {
		Ok({ before, .. }) if !before.is_empty() => Ok(before)
		_ => Err(NoChannel)
	}
}

# Rendering

## Everything after the marker.
render : List(Gathered), List(Native), Str -> Str
render = |pkgs, natives, rust| {
	lines = [marker, ""].concat(render_natives(natives)).concat(render_cargo(pkgs, rust))
	"${Str.join_with(lines, "\n").trim_end()}\n"
}

render_natives : List(Native) -> List(Str)
render_natives = |natives| {
	table = natives.join_map(|native| native.files.map(|(path, sha256)| "| `${path}` | ${native.name} ${native.version} | `${sha256}` |"))
	license_files = Files.unique(natives.map(|native| native.license_file))
	sections = license_files.join_map(
		|license_file| {
			users = natives.keep_if(|native| native.license_file == license_file)
			heading = users.first().map_ok(|native| native.name) ?? license_file
			text = users.first().map_ok(|native| normalize(native.text)) ?? ""
			["### ${heading}", ""]
				.concat(users.join_map(|native| ["- ${native.version} (${native.license}): ${native.origin}.", "  License: ${native.upstream}"]))
				.concat(["", code_block(text)])
		},
	)
	[
		"## Prebuilt native inputs",
		"",
		"These inputs are committed as they came. Their hashes are checked",
		"against `licenses/native-inputs.json`, which records where each one came from.",
		"",
		"| File | Component | SHA-256 |",
		"| --- | --- | --- |",
	]
		.concat(table)
		.concat([""])
		.concat(sections)
}

## One license text and the files that hold it. `text` is the first file's
## text as it came.
Group : { key : Str, body : Str, text : Str, users : List(Str), notices : List(Str) }

render_cargo : List(Gathered), Str -> List(Str)
render_cargo = |pkgs, rust| {
	used = pkgs.map(|pkg| (pkg, used_texts(pkg.license, pkg.texts)))
	table = used.map(|(pkg, { used_under, .. })| "| ${pkg.name} | ${pkg.version} | ${pkg.license} | ${used_under} | ${target_list(pkg.roc_targets)} |")
	groups = used.fold(
		[],
		|all, (pkg, { texts, .. })|
			texts.fold(
				all,
				|so_far, (file, text)| {
					{ notices, body } = split_notices(text)
					key = squeeze(body)
					user = "${pkg.name} ${pkg.version} (`${file}`)"
					held = notices.map(|notice| "${pkg.name} ${pkg.version}: ${notice}")
					if so_far.any(|group| group.key == key) {
						so_far.map(|group| if (group.key == key) { ..group, users: group.users.append(user), notices: Files.unique(group.notices.concat(held)) } else group)
					} else {
						so_far.append({ key, body, text, users: [user], notices: Files.unique(held) })
					}
				},
			),
	)
	license_texts = groups
		.sort_with(|a, b| Files.compare(Str.join_with(a.users, ", "), Str.join_with(b.users, ", ")))
		.join_map(render_group)
	source_notices = pkgs.join_map(
		|pkg|
			if (pkg.copyrights.is_empty()) [] else ["#### ${pkg.name} ${pkg.version}", "", code_block(Str.join_with(pkg.copyrights, "\n"))],
	)
	[
		"## Rust standard library",
		"",
		"Every host statically links the Rust ${rust} standard library. Its notices,",
		"including those for its own dependencies, are in Rust's `COPYRIGHT-library.html`,",
		"which every bundle carries as `COPYRIGHT-rust-library.html` next to this file.",
		"The document covers the standard library for all targets.",
		"",
		"## Cargo packages",
		"",
		"Generated from `Cargo.lock` for every Roc target. This lists normal dependencies",
		"(including procedural macros) but not build or dev dependencies, which are not",
		"linked into a host.",
		"",
		"A package offered under a choice of licenses is used under one of them, the",
		"one in the Used under column: MIT where it is offered, else Apache-2.0, else",
		"ISC (`preference` in the script has the whole order). The files of the licenses",
		"it is not used under are left out. A license text that several files hold is",
		"printed once, without its copyright lines, which follow it for every file. A",
		"text only one file holds is printed as it came.",
		"",
		"| Package | Version | License | Used under | Targets |",
		"| --- | --- | --- | --- | --- |",
	]
		.concat(table)
		.concat(["", "### License texts", ""])
		.concat(license_texts)
		.concat(["### Source copyright notices", "", "Copyright statements found in the headers of each package's source files.", ""])
		.concat(source_notices)
}

## A license text and the files that hold it. A text only one file holds is
## printed as it came, so a file that holds several licenses keeps each
## copyright line next to the terms it belongs to. A text several files hold
## is printed once without its copyright lines, which follow it.
render_group : Group -> List(Str)
render_group = |group|
	match group.users {
		[user] => ["Applies to: ${user}.", "", code_block(group.text)]
		_ => {
			applies = ["Applies to: ${Str.join_with(group.users, ", ")}.", "", code_block(group.body)]
			if (group.notices.is_empty()) applies else applies.concat(["Copyright lines in these files:", "", code_block(Str.join_with(group.notices, "\n"))])
		}
	}

## A license text without its copyright lines, and those lines. The
## template lines of a license that was never filled in (`Copyright [yyyy]
## [name of copyright owner]`) go from the text and are not listed. A title
## line ("The MIT License (MIT)") goes too, as it is no part of the terms and
## would keep the same terms apart.
split_notices : Str -> { notices : List(Str), body : Str }
split_notices = |text| {
	lines = text.split_on("\n")
	notices = lines.keep_if(is_copyright_line).map(Str.trim).drop_if(is_template)
	body = normalize(Str.join_with(collapse_blank_lines(lines.drop_if(|line| is_copyright_line(line) or is_title(line))), "\n"))
	{ notices, body }
}

is_title : Str -> Bool
is_title = |line| ["mit license", "the mit license", "mit license (mit)", "the mit license (mit)"].contains(line.trim().with_ascii_lowercased())

## A line that states a copyright: "Copyright" with a year, "(c)" or "©"
## after it, or "(c)" or "©" with a year. A line of the license's own words
## has neither: "copyright notice that is included" has no year, and the
## Apache clause "(c) You must retain" has none either.
is_copyright_line : Str -> Bool
is_copyright_line = |line| {
	t = line.trim().with_ascii_lowercased()
	year = has_year(t.to_utf8())
	if t.starts_with("copyright") {
		year or t.contains("(c)") or t.contains("©") or is_template(t)
	} else if t.starts_with("(c)") or t.starts_with("©") {
		year
	} else {
		False
	}
}

is_template : Str -> Bool
is_template = |line| {
	t = line.with_ascii_lowercased()
	["[yyyy]", "{yyyy}", "<year>", "[year]", "<copyright holders>", "[name of copyright owner]", "{name of copyright owner}"].any(|template| t.contains(template))
}

has_year : List(U8) -> Bool
has_year = |bytes|
	match bytes {
		[a, b, c, d, ..] if ((a == '1' and b == '9') or (a == '2' and b == '0')) and is_digit(c) and is_digit(d) => True
		[_, .. as rest] => has_year(rest)
		[] => False
	}

collapse_blank_lines : List(Str) -> List(Str)
collapse_blank_lines = |lines|
	lines.fold(
		[],
		|kept, line|
			if (line.trim().is_empty() and (kept.last().map_ok(|previous| previous.trim().is_empty()) ?? True)) kept else kept.append(line),
	)

target_list : List(Str) -> Str
target_list = |roc_targets|
	if (rust_targets.all(|(roc_target, _)| roc_targets.contains(roc_target))) "all" else Str.join_with(roc_targets, ", ")

## A fenced block that no run of backticks in the text can close.
code_block : Str -> Str
code_block = |text| {
	longest = text.to_utf8().fold(
		(0, 0),
		|(most, run), byte|
			if byte == '`' {
				(if (run + 1 > most) run + 1 else most, run + 1)
			} else {
				(most, 0)
			},
	)
	(most, _) = longest
	fence = "`".repeat(if (most + 1 > 3) most + 1 else 3)
	"${fence}text\n${text}\n${fence}\n"
}

# Text helpers

## A text with Unix line ends, no trailing spaces and no blank lines at its
## start or end.
normalize : Str -> Str
normalize = |text| {
	lines = text.replace_each("\r\n", "\n").replace_each("\r", "\n").split_on("\n").map(Str.trim_end)
	Str.join_with(drop_blank_ends(lines), "\n")
}

drop_blank_ends : List(Str) -> List(Str)
drop_blank_ends = |lines|
	match lines {
		[first, .. as rest] if first.is_empty() => drop_blank_ends(rest)
		[.. as rest, last] if last.is_empty() => drop_blank_ends(rest)
		_ => lines
	}

## The words of a text with one space between them.
squeeze : Str -> Str
squeeze = |text| Str.join_with(Str.from_utf8_lossy(text.to_utf8().map(|byte| if (Text.is_space(byte)) ' ' else byte)).split_on(" ").drop_if(Str.is_empty), " ")

is_digit : U8 -> Bool
is_digit = |byte| byte >= '0' and byte <= '9'

drop_trailing : List(U8), (U8 -> Bool) -> List(U8)
drop_trailing = |bytes, drop|
	match bytes {
		[.. as rest, last] if drop(last) => drop_trailing(rest, drop)
		_ => bytes
	}

drop_optional : List(U8), U8 -> List(U8)
drop_optional = |bytes, byte|
	match bytes {
		[first, .. as rest] if first == byte => rest
		_ => bytes
	}

then_compare : [Before, Same, After], Str, Str -> [Before, Same, After]
then_compare = |first, a, b|
	match first {
		Same => Files.compare(a, b)
		_ => first
	}

compare_u64 : U64, U64 -> [Before, Same, After]
compare_u64 = |a, b| if (a < b) Before else if (a > b) After else Same

# Tests

fake_package : Str -> Cargo.Package
fake_package = |id| { id, name: id, version: "1.0.0", license: Ok("MIT"), license_file: Err(Null), source: Ok("registry+https://github.com/rust-lang/crates.io-index"), repository: Err(Null), manifest_path: "/${id}/Cargo.toml" }

fake_dep : Str, Try(Str, [Null]) -> Cargo.Dep
fake_dep = |pkg, kind| { pkg, dep_kinds: [{ kind: kind }] }

# Only normal dependencies are linked.
expect {
	metadata = {
		crates: ["root", "lib", "transitive", "build", "dev", "build-only"].map(fake_package),
		resolve: Ok({
			root: Ok("root"),
			nodes: [
				{ id: "root", deps: [fake_dep("lib", Err(Null)), fake_dep("build", Ok("build")), fake_dep("dev", Ok("dev"))] },
				{ id: "lib", deps: [fake_dep("transitive", Err(Null))] },
				{ id: "transitive", deps: [] },
				{ id: "build", deps: [fake_dep("build-only", Err(Null))] },
				{ id: "dev", deps: [] },
				{ id: "build-only", deps: [] },
			],
		}),
	}
	Cargo.linked(metadata, WithoutRoot).map(|pkg| pkg.id).sort_with(Files.compare) == ["lib", "transitive"] and Cargo.linked(metadata, WithRoot).len() == 3
}

# License expressions must name reviewed licenses.
expect ["Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT", "Apache-2.0 / MIT", "(MIT OR Apache-2.0) AND Unicode-3.0"].all(|expression| Licenses.check("ok", "1", expression).is_ok())
expect ["MIT OR GPL-3.0-only", ""].all(|expression| Licenses.check("bad", "1", expression).is_err())
expect Licenses.check("bad", "1.2", "MIT OR GPL-3.0") == Err(Failed("Unreviewed license expression for bad 1.2: \"MIT OR GPL-3.0\""))
expect Licenses.check("gpl", "1", "GPL-2.0 WITH Classpath-exception-2.0").is_err()

# License files are found anywhere in a package, by name, and the manifest's
# license_file too, but never source or code.
expect license_candidates(["Cargo.toml", "LICENSE-MIT", "third_party/fiat/LICENSE", "legal/TERMS.txt", "license.rs", "src/lib.rs", "COPYING.py"], Ok("legal/TERMS.txt")) == ["LICENSE-MIT", "third_party/fiat/LICENSE", "legal/TERMS.txt"]
expect ["LICENSE", "licence.txt", "UNLICENSE", "COPYING.txt", "NOTICE", "License_x", "a/COPYRIGHT"].all(Licenses.is_license_file) and !(["LICENSES", "README", "notices.md", "src/license.rs"].any(Licenses.is_license_file))

# A package without license files is refused.
expect require_texts("bare", "1.0.0", []) == Err(Failed("No license files for bare 1.0.0"))

# Texts are normalized.
expect normalize("\n\nMIT text  \r\nsecond\r\n\n") == "MIT text\nsecond"

# Source copyrights come from comment paragraphs.
expect copyright_paragraphs("/* Copyright 2015 Example Inc.\n * All rights reserved. */\n\n/* Unrelated paragraph. */\n#if defined(COPYRIGHT)\n") == ["Copyright 2015 Example Inc.\nAll rights reserved."]
expect copyright_paragraphs("#!/usr/bin/env perl\n# Copyright 2016 Perl Author\n") == ["Copyright 2016 Perl Author"]
expect copyright_paragraphs("#![doc = \"copyright\"]\npub const COPYRIGHT: u32 = 1;\n// Adapted from public domain code.\n") == ["Adapted from public domain code."]
expect copyright_paragraphs("${"\n".repeat(header_lines)}// Copyright late\n") == []
expect comment_text("## heading") == "heading" and comment_text("##if x") == "#if x" and comment_text("#ifdef X") == "" and comment_text("  //! inner doc") == "inner doc"

# A code block's fence outlasts any run of backticks in it.
expect code_block("a ```` b") == "`````text\na ```` b\n`````\n"

# Native inputs.
fake_native : List((Str, Str)) -> Native
fake_native = |files| { name: "musl libc", version: "1", license: "MIT", license_file: "COPYRIGHT.txt", upstream: "https://example.invalid", origin: "fixture", files, text: "musl terms" }

expect check_native([fake_native([("platform/targets/x64musl/libc.a", "aa")])], [("platform/targets/x64musl/libc.a", Ok("aa"))], ["platform/targets/x64musl/libc.a", "platform/targets/x64musl/libhost.a"]) == Ok({})
expect check_native([fake_native([("platform/targets/x64musl/libc.a", "aa")])], [("platform/targets/x64musl/libc.a", Ok("bb"))], ["platform/targets/x64musl/libc.a"]).is_err()
expect check_native([fake_native([("platform/targets/x64musl/libc.a", "aa")])], [("platform/targets/x64musl/libc.a", Err(Missing))], []).is_err()
expect check_native([], [], ["platform/targets/arm64musl/nested/crt1.o"]) == Err(Failed("Prebuilt inputs without a provenance record: platform/targets/arm64musl/nested/crt1.o"))

# License expressions and the choice between their licenses.
expect license_choices("MIT OR Apache-2.0") == [["MIT"], ["Apache-2.0"]]
expect license_choices("Apache-2.0/MIT") == [["Apache-2.0"], ["MIT"]]
expect license_choices("(MIT OR Apache-2.0) AND Unicode-3.0") == [["MIT", "Unicode-3.0"], ["Apache-2.0", "Unicode-3.0"]]
expect license_choices("Apache-2.0 WITH LLVM-exception OR MIT") == [["Apache-2.0 WITH LLVM-exception"], ["MIT"]]
expect elect("Apache-2.0 OR ISC OR MIT", ["Apache-2.0", "ISC", "MIT"]) == Ok(["MIT"])
expect elect("MIT OR Apache-2.0", ["Apache-2.0"]) == Ok(["Apache-2.0"])
expect elect("MIT OR Apache-2.0", []) == Err(NoChoice)

mit_text : Str
mit_text = "Copyright (c) 2014 Alex Crichton\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software."

apache_text : Str
apache_text = "                              Apache License\n                        Version 2.0, January 2004\n\n   the copyright owner or by an individual\n   copyright notice that is included in or attached to the work\n   (c) You must retain, in the Source form of any Derivative Works\n\n   Copyright [yyyy] [name of copyright owner]"

# A package used under MIT keeps its MIT text and its other notices, not
# its Apache text.
expect {
	used = used_texts("MIT OR Apache-2.0", [("COPYRIGHT", "Short version for non-lawyers"), ("LICENSE-APACHE", apache_text), ("LICENSE-MIT", mit_text)])
	used == { used_under: "MIT", texts: [("COPYRIGHT", "Short version for non-lawyers"), ("LICENSE-MIT", mit_text)] }
}

# Without any text this script knows, a package keeps every file.
expect used_texts("MIT OR Apache-2.0", [("LICENSE", "custom terms")]) == { used_under: "MIT OR Apache-2.0", texts: [("LICENSE", "custom terms")] }

bsd3_text : Str
bsd3_text = "Copyright (c) 2010 Vendored Authors\n\nRedistribution and use in source and binary forms, with or without\nmodification, are permitted. Neither the name of the copyright holder."

# A vendored license deeper in a package stays, even one the package's own
# expression does not offer.
expect {
	texts = [("LICENSE", mit_text), ("third_party/vendored/LICENSE", bsd3_text)]
	used_texts("MIT", texts) == { used_under: "MIT", texts }
}

# Of `X OR Y`, the root license that was not chosen goes, and a deeper copy
# of it stays.
expect {
	used = used_texts("MIT OR Apache-2.0", [("LICENSE-APACHE", apache_text), ("LICENSE-MIT", mit_text), ("vendor/LICENSE-APACHE", apache_text)])
	used == { used_under: "MIT", texts: [("LICENSE-MIT", mit_text), ("vendor/LICENSE-APACHE", apache_text)] }
}

# A root file that also holds a license the expression does not offer stays.
expect used_texts("MIT OR Apache-2.0", [("LICENSE-APACHE", "${apache_text}\n\n${bsd3_text}"), ("LICENSE-MIT", mit_text)]).texts.len() == 2

# Copyright lines and a title leave the text, the license's own words stay.
expect split_notices(mit_text) == { notices: ["Copyright (c) 2014 Alex Crichton"], body: "Permission is hereby granted, free of charge, to any person obtaining a copy\nof this software." }
expect split_notices("    The MIT License (MIT)\n\n${mit_text}") == split_notices(mit_text)
expect {
	{ notices, body } = split_notices(apache_text)
	notices == [] and body.contains("copyright notice that is included") and body.contains("the copyright owner or by") and body.contains("(c) You must retain") and !body.contains("[yyyy]")
}

gathered : Str, List(Str), List((Str, Str)) -> Gathered
gathered = |name, roc_targets, texts| { name, version: "1.0.0", license: "MIT", roc_targets, texts, copyrights: [] }

# Identical texts are printed once, with every file's copyright lines.
expect {
	first = gathered("first", rust_targets.map(|(roc_target, _)| roc_target), [("LICENSE", "Copyright 2020 First\nSame   terms\n")])
	second = gathered("second", ["x64win"], [("LICENSE-MIT", "Same\nterms\nCopyright (c) Second")])
	text = render([first, second], [fake_native([("a.o", "00")])], "1.0.0")
	text.starts_with(marker)
		and text.contains("| first | 1.0.0 | MIT | MIT | all |")
		and text.contains("| second | 1.0.0 | MIT | MIT | x64win |")
		and text.contains("Applies to: first 1.0.0 (`LICENSE`), second 1.0.0 (`LICENSE-MIT`).")
		and text.split_on("Same").len() == 2
		and text.contains("first 1.0.0: Copyright 2020 First\nsecond 1.0.0: Copyright (c) Second")
		and text.contains("musl terms")
}

# A text only one file holds keeps its copyright lines where they are.
expect {
	composite = "Copyright 2015 Chromium Authors\nRedistribution terms\n\nCopyright (c) 2009 Go Authors\nOther terms"
	text = render([gathered("ring", ["x64musl"], [("LICENSE-BoringSSL", composite)])], [], "1.0.0")
	text.contains(composite) and !text.contains("Copyright lines in these files")
}

# Only what follows the marker is generated.
expect with_generated("# Preamble\n\n${marker}\nstale\n", "${marker}\nnew\n") == Ok("# Preamble\n\n${marker}\nnew\n")
expect with_generated("# Preamble without marker\n", "") == Err(Failed("THIRD_PARTY_LICENSES.md is missing the generated-section marker"))

expect rust_version("# channel = \"nightly\"\nchannel = \"1.97.1\" # note\n") == Ok("1.97.1")
