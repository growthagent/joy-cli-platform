import pf.Env
import pf.OsStr
import pf.Stdout
import Cargo
import Files
import JsonValue
import Licenses
import Process
import Targets

## Builds the redistributable MSVC inputs of the Windows host, and never
## copies a Microsoft SDK library.
##
## The import libraries are generated from the mingw-w64 definitions Zig
## bundles. The runtime sources are vendored, with their original license and
## source hashes. Both the generated inputs and their notices travel in the
## platform bundle, and `PROVENANCE.json` records where each came from.
##
## Paths are taken from the repository root, the folder the scripts run in,
## unless a function takes a folder.
WindowsRuntime := [].{

	## The Zig release that builds the runtime inputs, and the source release
	## its mingw-w64 definitions come from.
	zig_release : { version : Str, source_url : Str, source_sha256 : Str }
	zig_release = {
		version: "0.17.1",
		source_url: "https://ziglang.org/download/0.17.1/zig-0.17.1.tar.xz",
		source_sha256: "1e89bf06610b769a8c77676c6c8d54b093a0db60f4891f2f91014829012f0e24",
	}

	## The libraries the runtime build produces. The host adds `host.lib`.
	libraries : List(Str)
	libraries = ["windows_support.lib"]

	## Files with these extensions are linked, so each must be recorded.
	binary_extensions : List(Str)
	binary_extensions = [".a", ".o", ".lib", ".obj"]

	manifest_name : Str
	manifest_name = "PROVENANCE.json"

	source_dir : Str
	source_dir = "native/windows"

	system_libraries : List(Str)
	system_libraries = ["advapi32", "bcrypt", "crypt32", "dbghelp", "iphlpapi", "kernel32", "ncrypt", "ntdll", "ole32", "secur32", "shell32", "user32", "userenv", "ws2_32"]

	ucrt_libraries : List(Str)
	ucrt_libraries = ["conio", "convert", "environment", "filesystem", "heap", "locale", "math", "multibyte", "private", "process", "runtime", "stdio", "string", "time", "utility"].map(|name| "api-ms-win-crt-${name}-l1-1-0")

	import_libraries : List(Str)
	import_libraries = WindowsRuntime.ucrt_libraries.concat(WindowsRuntime.system_libraries)

	runtime_libraries : List(Str)
	runtime_libraries = ["msvc_runtime.lib"]

	build_libraries : List(Str)
	build_libraries = WindowsRuntime.runtime_libraries.concat(WindowsRuntime.import_libraries.map(|name| "${name}.lib"))

	## Whether a file is linked, by its extension in any case.
	is_binary : Str -> Bool
	is_binary = |path| WindowsRuntime.binary_extensions.contains(Files.suffix_of(path).with_ascii_lowercased())

	## A relative path with `.` and `..` resolved, or `Escapes` when it leaves
	## its folder or is absolute.
	within : Str -> Try(Str, [Escapes])
	within = |relative| {
		path = Files.posix(relative)
		first = path.split_on("/").first() ?? ""
		if path.starts_with("/") or first.contains(":") {
			return Err(Escapes)
		}
		parts = path.split_on("/").fold_try(
			[],
			|kept, part|
				if part == "" or part == "." {
					Ok(kept)
				} else if part == ".." {
					if (kept.is_empty()) Err(Escapes) else Ok(kept.drop_last(1))
				} else {
					Ok(kept.append(part))
				},
		)?
		Ok(Str.join_with(parts, "/"))
	}

	## Drops the stdcall `@<bytes>` suffixes Win64 does not use, and keeps
	## export ordinals (`@123` after a space).
	normalize_definition : Str -> Str
	normalize_definition = |source| {
		bytes = source.to_utf8()
		is_word = |c| (c >= '0' and c <= '9') or (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or c == '_' or c >= 0x80
		var $out = []
		var $at = 0
		while $at < bytes.len() {
			c = bytes.get($at) ?? 0
			after_word = $at > 0 and is_word(bytes.get($at - 1) ?? 0)
			var $digits = 0
			while bytes.get($at + 1 + $digits).map_ok(|d| d >= '0' and d <= '9') ?? False {
				$digits = $digits + 1
			}
			at_boundary = !is_word(bytes.get($at + 1 + $digits) ?? ' ')
			if c == '@' and after_word and $digits > 0 and at_boundary {
				$at = $at + 1 + $digits
			} else {
				$out = $out.append(c)
				$at = $at + 1
			}
		}
		"; Generated by basic-cli (2026-10-12): x64 stdcall names normalized.\n${Str.from_utf8_lossy($out)}"
	}

	## The `lib_dir` of `zig env`, which Zig 0.17 prints as ZON.
	lib_dir_of : Str -> Try(Str, [Failed(Str)])
	lib_dir_of = |env| {
		missing = Failed("zig env did not report lib_dir")
		after = (env.split_first(".lib_dir") ? |_| missing).after.trim_start()
		value = if (after.starts_with("=")) after.drop_prefix("=").trim_start() else return Err(missing)
		if !value.starts_with("\"") {
			return Err(missing)
		}
		(dir, _) = JsonValue.string_at(value.to_utf8(), 1) ? |_| missing
		Ok(dir)
	}

	# Building

	## The Zig executable ZIG names, or the one on PATH, with its links
	## resolved, after checking that it is the pinned release.
	resolve_zig! : () => Try(Str, [Failed(Str)])
	resolve_zig! = || {
		name = Env.var_str!(OsStr.from_str("ZIG")) ?? "zig"
		WindowsRuntime.resolve_zig_in!(name, Env.var_str!(OsStr.from_str("PATH")) ?? "")
	}

	## `resolve_zig!` for a ZIG and a PATH.
	resolve_zig_in! : Str, Str => Try(Str, [Failed(Str)])
	resolve_zig_in! = |name, path|
		match Process.which_in!(name, path) {
			Ok(found) => {
				resolved = Files.canonical!(found) ?? found
				version = Process.capture!([resolved, "version"])?
				if version == WindowsRuntime.zig_release.version {
					Ok(resolved)
				} else {
					Err(Failed("Windows runtime inputs require Zig ${WindowsRuntime.zig_release.version}, found ${version}"))
				}
			}
			Err(NotFound) => Err(Failed("Zig was not found. Install Zig ${WindowsRuntime.zig_release.version} or set ZIG to its executable"))
		}

	zig_lib_dir! : Str => Try(Str, [Failed(Str)])
	zig_lib_dir! = |zig| Ok(Files.posix(WindowsRuntime.lib_dir_of(Process.capture!([zig, "env"])?)?))

	## Writes a notice into `licenses/` of a folder, and returns its path
	## there.
	notice! : Str, Str, List(U8) => Try(Str, [Failed(Str)])
	notice! = |output, name, contents| {
		Files.write_bytes!("${output}/licenses/${name}", contents)?
		Ok("licenses/${name}")
	}

	## The path below `base` and the hash of each file.
	source_records! : Str, List(Str) => Try(JsonValue, [Failed(Str)])
	source_records! = |base, relatives| {
		records = relatives.fold_try!([], |all, relative| Ok(all.append(Object([("path", Text(relative)), ("sha256", Text(Files.sha256!("${base}/${relative}")?))]))))?
		Ok(Array(records))
	}

	## What native/windows/UPSTREAM.json records of the vendored Roc sources.
	Upstream : { commit : Str, files : Dict(Str, Str), license_sha256 : Str }

	build_runtime! : Str, Str, Str, Str, Str => Try(JsonValue, [Failed(Str), CommandFailed(Str, I32)])
	build_runtime! = |root, output, scratch, zig_lib, zig| {
		source = "${root}/${WindowsRuntime.source_dir}"
		parsed : Try(WindowsRuntime.Upstream, _)
		parsed = Json.parse(Files.read_text!("${source}/UPSTREAM.json")?)
		upstream = parsed ? |err| Failed("${WindowsRuntime.source_dir}/UPSTREAM.json needs commit, files and license_sha256: ${Str.inspect(err)}")
		files = upstream.files.to_list().sort_with(|(a, _), (b, _)| Files.compare(a, b))
		for (name, expected) in files {
			if expected != Files.sha256!("${source}/${name}")? {
				return Err(Failed("Vendored source changed without updating provenance: ${name}"))
			}
		}
		license_path = "${source}/LICENSE.roc.txt"
		if upstream.license_sha256 != Files.sha256!(license_path)? {
			return Err(Failed("Vendored Roc license does not match UPSTREAM.json"))
		}
		license_file = WindowsRuntime.notice!(output, "roc-UPL-1.0.txt", Files.read_bytes!(license_path)?)?
		zig_license = WindowsRuntime.notice!(output, "zig-MIT.txt", Files.read_bytes!("${Files.parent_of(zig_lib)}/LICENSE")?)?
		basic_cli_license = WindowsRuntime.notice!(output, "basic-cli-UPL-1.0.txt", "Original runtime support: Copyright 2026 basic-cli contributors.\n\n".to_utf8().concat(Files.read_bytes!("${root}/LICENSE")?))?
		common = ["-target", "x86_64-windows-msvc", "-O", "ReleaseFast", "-fno-stack-check"]
		tls = "${scratch}/tls.obj"
		security = "${scratch}/security.obj"
		type_info = "${scratch}/type_info.obj"
		commands = [
			[zig, "build-obj", "${source}/tls.zig"].concat(common).append("-femit-bin=${tls}"),
			[zig, "build-obj", "${source}/security.zig"].concat(common).append("-femit-bin=${security}"),
			[zig, "c++", "-target", "x86_64-windows-msvc", "-O2", "-g0", "-fno-exceptions", "-fno-rtti", "-fno-sized-deallocation", "-nostdinc", "-c", "${source}/type_info.cpp", "-o", type_info],
			[zig, "build-lib", "${source}/exe_startup.zig", tls, security, type_info].concat(common).concat(["-fcompiler-rt", "-femit-bin=${output}/msvc_runtime.lib"]),
		]
		for command in commands {
			Process.run!(command, [])?
		}
		compiler_rt = Files.files_under!("${zig_lib}/compiler_rt")?.keep_if(|path| path.ends_with(".zig")).map(|path| "compiler_rt/${path}")
		Ok(
			Object([
				("component", Text("Roc MSVC startup, initializer tables, TLS, and Zig compiler-rt")),
				("source_url", Text("https://github.com/roc-lang/roc/tree/${upstream.commit}/src/default_platform/msvc_runtime")),
				("source_revision", Text(upstream.commit)),
				("sources", WindowsRuntime.source_records!(source, files.map(|(name, _)| name))?),
				("zig_version", Text(WindowsRuntime.zig_release.version)),
				("compiler_rt_sources", WindowsRuntime.source_records!(zig_lib, compiler_rt.append("compiler_rt.zig").sort_with(Files.compare))?),
				("license", Text("UPL-1.0 AND MIT")),
				("license_files", JsonValue.texts([license_file, zig_license, basic_cli_license])),
				("redistribution_basis", Text("UPL-1.0 and MIT permit source and binary redistribution with notices retained.")),
				("build_commands", Array(commands.map(JsonValue.texts))),
				("local_sources", WindowsRuntime.source_records!(root, ["security.zig", "type_info.cpp"].map(|name| "${WindowsRuntime.source_dir}/${name}"))?),
				("modifications", JsonValue.texts(["Added original UPL-1.0 stack-cookie and MSVC type-info metadata support. The upstream Roc sources are unmodified."])),
			]),
		)
	}

	build_imports! : Str, Str, Str, Str => Try(JsonValue, [Failed(Str), CommandFailed(Str, I32)])
	build_imports! = |output, scratch, zig_lib, zig| {
		mingw = "${zig_lib}/libc/mingw"
		license_file = WindowsRuntime.notice!(output, "mingw-w64-ZPL-2.1.txt", Files.read_bytes!("${mingw}/COPYING")?)?
		# The whole definition and include set is recorded, not only each entry .def.
		sources = ["lib-common", "lib64", "def-include"].fold_try!(
			[],
			|all, dir| Ok(all.concat(Files.files_under!("${mingw}/${dir}")?.map(|path| "libc/mingw/${dir}/${path}"))),
		)?
		var $commands = []
		for name in WindowsRuntime.import_libraries {
			candidates = ["lib64", "lib-common"].join_map(|dir| [".def", ".def.in"].map(|suffix| "${mingw}/${dir}/${name}${suffix}"))
			source = Files.first_file!(candidates) ? |_| Failed("Zig ${WindowsRuntime.zig_release.version} has no mingw-w64 definition for ${name}")
			definition = "${scratch}/${name}.def"
			preprocess = [zig, "cc", "-E", "-P", "-x", "c", "-target", "x86_64-windows-msvc", "-Wno-extra-tokens", "-Wno-invalid-pp-token", "-I", "${mingw}/def-include", "-I", "${mingw}/lib-common", source, "-o", definition]
			Process.run!(preprocess, [])?
			Files.write_text!(definition, WindowsRuntime.normalize_definition(Files.read_text!(definition)?))?
			import_lib = [zig, "dlltool", "-m", "i386:x86-64", "-d", definition, "-l", "${output}/${name}.lib"]
			Process.run!(import_lib, [])?
			$commands = $commands.append(preprocess).append(import_lib)
		}
		Ok(
			Object([
				("component", Text("mingw-w64 UCRT and Win32 import definitions bundled with Zig")),
				("source_url", Text(WindowsRuntime.zig_release.source_url)),
				("source_sha256", Text(WindowsRuntime.zig_release.source_sha256)),
				("zig_version", Text(WindowsRuntime.zig_release.version)),
				("sources", WindowsRuntime.source_records!(zig_lib, sources)?),
				("license", Text("ZPL-2.1")),
				("license_files", JsonValue.texts([license_file])),
				("redistribution_basis", Text("mingw-w64 COPYING permits source and binary redistribution with its copyright, conditions, and disclaimer retained.")),
				("build_commands", Array($commands.map(JsonValue.texts))),
				("modifications", JsonValue.texts(["Preprocessed architecture-specific definitions and removed stdcall @byte-count suffixes for x64 COFF imports (2026-10-12). The source files are unmodified and no DLL code is distributed."])),
			]),
		)
	}

	## Every license file the components name.
	license_files_of : List((Str, JsonValue)) -> List(Str)
	license_files_of = |components|
		components.join_map(|(_, component)| JsonValue.items_of(JsonValue.field(component, "license_files") ?? Null).keep_oks(JsonValue.text_of))

	## The manifest of the components, the libraries with the component each
	## comes from and its hash, and the hash of each license file.
	manifest_of : List((Str, JsonValue)), List((Str, Str, Str)), List((Str, Str)) -> JsonValue
	manifest_of = |components, library_hashes, documents|
		Object([
			("format_version", Number("1")),
			("components", Object(components)),
			("libraries", Object(library_hashes.map(|(name, component, sha256)| (name, Object([("component", Text(component)), ("sha256", Text(sha256))]))))),
			("documents", Object(documents.sort_with(|(a, _), (b, _)| Files.compare(a, b)).map(|(path, sha256)| (path, Text(sha256))))),
		])

	## Writes the PROVENANCE.json of a folder: the components, and for each
	## library the component it comes from.
	write_manifest! : Str, List((Str, JsonValue)), List((Str, Str)) => Try({}, [Failed(Str)])
	write_manifest! = |output, components, library_components| {
		library_hashes = library_components.fold_try!([], |all, (name, component)| Ok(all.append((name, component, Files.sha256!("${output}/${name}")?))))?
		documents = Files.unique(WindowsRuntime.license_files_of(components)).fold_try!([], |all, relative| Ok(all.append((relative, Files.sha256!("${output}/${relative}")?))))?
		Files.write_text!("${output}/${WindowsRuntime.manifest_name}", "${JsonValue.render(WindowsRuntime.manifest_of(components, library_hashes, documents))}\n")
	}

	read_manifest! : Str => Try(JsonValue, [Failed(Str)])
	read_manifest! = |output| JsonValue.parse(Files.read_text!("${output}/${WindowsRuntime.manifest_name}")?).map_err(|BadJson(why)| Failed("${WindowsRuntime.manifest_name} is not valid JSON: ${why}"))

	## Builds `windows_support.lib` and its notices into a folder, and records
	## them in its PROVENANCE.json.
	build! : Str, Str => Try({}, [Failed(Str), CommandFailed(Str, I32)])
	build! = |output_dir, zig| {
		root = Files.root!()?
		Files.make_dir!(output_dir)?
		output = Files.canonical!(output_dir)?
		scratch = "${root}/target/windows-runtime"
		parts = "${scratch}/parts"
		Files.make_dir!(parts)?
		zig_lib = WindowsRuntime.zig_lib_dir!(zig)?
		runtime = WindowsRuntime.build_runtime!(root, parts, scratch, zig_lib, zig)?
		import_part = WindowsRuntime.build_imports!(parts, scratch, zig_lib, zig)?
		license_files = Files.unique_sorted(WindowsRuntime.license_files_of([("runtime", runtime), ("imports", import_part)]))
		for relative in license_files {
			Files.copy_file!("${parts}/${relative}", "${output}/${relative}")?
		}
		archive = "${output}/windows_support.lib"
		# ADDLIB flattens archives and keeps every member, repeated COFF import
		# member names included. Extracting into one folder would lose them.
		script = "CREATE \"${Files.posix(archive)}\"\n${Str.join_with(WindowsRuntime.build_libraries.map(|name| "ADDLIB \"${Files.posix("${parts}/${name}")}\"\n"), "")}SAVE\nEND\n"
		merge_command = [zig, "ar", "--format=coff", "-M"]
		Process.run_with_stdin!(merge_command, [], Bytes(script.to_utf8()))?
		support_sources = WindowsRuntime.build_libraries.fold_try!(
			[],
			|all, name| {
				component = if (WindowsRuntime.runtime_libraries.contains(name)) "runtime" else "imports"
				Ok(all.append(Object([("path", Text(name)), ("sha256", Text(Files.sha256!("${parts}/${name}")?)), ("component", Text(component))])))
			},
		)?
		support = Object([
			("component", Text("Combined MSVC startup/runtime and Windows import archive")),
			("subcomponents", JsonValue.texts(["runtime", "imports"])),
			("sources", Array(support_sources)),
			("license", Text("UPL-1.0 AND MIT AND ZPL-2.1")),
			("license_files", JsonValue.texts(license_files)),
			("redistribution_basis", Text("The original grants and notices of both subcomponents are retained. Merging the archives adds no third-party code.")),
			("build_commands", Array([JsonValue.texts(merge_command)])),
			("archive_script", Text(script)),
			("modifications", JsonValue.texts(["Combined the generated archives without changing their object members (2026-10-12)."])),
		])
		components = [("runtime", runtime), ("imports", import_part), ("support", support)]
		WindowsRuntime.write_manifest!(output, components, [("windows_support.lib", "support")])?
		_ = WindowsRuntime.validate!(output, False)?
		Ok({})
	}

	## Adds the host to the PROVENANCE.json of the runtime build: the license
	## files of every Cargo package linked into it, with the copyright headers
	## of their sources, and Rust's standard library notices.
	##
	## The SPDX metadata is checked against the reviewed permissive set, which
	## grants nothing by itself. The original license and notice files are
	## recorded with the source checksums, and a package without them stops
	## the build.
	record_host! : Str, List(List(Str)), List((Str, Str)) => Try({}, [Failed(Str), CommandFailed(Str, I32)])
	record_host! = |output_dir, build_commands, toolchain| {
		root = Files.root!()?
		output = Files.canonical!(output_dir)?
		metadata = Cargo.metadata!(["--locked", "--filter-platform", Targets.windows_rust_target])?
		checksums = Cargo.lock_checksums(Files.read_text!("${root}/Cargo.lock")?)
		crates = Cargo.linked(metadata, WithRoot).sort_with(
			|a, b|
				match Files.compare(a.name, b.name) {
					Same => Files.compare(a.version, b.version)
					order => order
				},
		)
		var $packages = []
		var $license_files = []
		for pkg in crates {
			Licenses.check(pkg.name, pkg.version, pkg.license ?? "")?
			directory = Files.parent_of(Files.posix(pkg.manifest_path))
			files = if (pkg.source.is_ok()) Files.files_under!(directory)? else []
			originals =
				match pkg.source {
					Err(Null) => [("${root}/LICENSE", "LICENSE")]
					Ok(_) => files.keep_if(Licenses.is_license_file).map(|path| ("${directory}/${path}", path))
				}
			if originals.is_empty() {
				return Err(Failed("No license files for ${pkg.name} ${pkg.version}"))
			}
			var $package_licenses = []
			for (original, relative) in originals {
				copied = WindowsRuntime.notice!(output, "cargo/${pkg.name}-${pkg.version}/${relative}", Files.read_bytes!(original)?)?
				$package_licenses = $package_licenses.append(copied)
			}
			# Source file headers can carry notices beyond the package's common
			# license text. ring's BoringSSL assembly is one such component.
			copyrights = files
				.keep_if(|path| [".rs", ".c", ".cc", ".h", ".S", ".asm"].contains(Files.suffix_of(path)))
				.fold_try!(
					[],
					|found, path| {
						header = Files.read_text!("${directory}/${path}")?.replace_each("\r\n", "\n").replace_each("\r", "\n").split_on("\n").take_first(100)
						speaks = header.any(
							|line| {
								lowered = line.with_ascii_lowercased()
								lowered.contains("copyright") or lowered.contains("public domain")
							},
						)
						Ok(if (speaks) found.append("${path}\n${Str.join_with(header, "\n")}") else found)
					},
				)?
			if !copyrights.is_empty() {
				copied = WindowsRuntime.notice!(output, "cargo/${pkg.name}-${pkg.version}/SOURCE-NOTICES.txt", "${Str.join_with(copyrights, "\n\n")}\n".to_utf8())?
				$package_licenses = $package_licenses.append(copied)
			}
			$license_files = $license_files.concat($package_licenses)
			(_, _, sha256) = checksums.find_first(|(name, version, _)| name == pkg.name and version == pkg.version) ? |_| Failed("Cargo.lock has no entry for ${pkg.name} ${pkg.version}")
			$packages = $packages.append(
				Object([
					("name", Text(pkg.name)),
					("version", Text(pkg.version)),
					("license", JsonValue.nullable(pkg.license)),
					("source", JsonValue.nullable(pkg.source)),
					("repository", JsonValue.nullable(pkg.repository)),
					("source_package_sha256", JsonValue.nullable(sha256)),
					("license_files", JsonValue.texts($package_licenses)),
				]),
			)
		}
		# Rust's document has the full notices of the standard library and its
		# compiler-builtins and native parts, not just of Cargo dependencies.
		rust_notices = "${Files.posix(Process.capture!(["rustc", "--print", "sysroot"])?)}/share/doc/rust/COPYRIGHT-library.html"
		if !Files.is_file!(rust_notices) {
			return Err(Failed("Rust standard library notices are missing. Install the rust-docs component"))
		}
		$license_files = $license_files.append(WindowsRuntime.notice!(output, "rust/COPYRIGHT-library.html", Files.read_bytes!(rust_notices)?)?)
		rust_sources = Files.files_under!("${root}/src")?.keep_if(|path| path.ends_with(".rs")).map(|path| "src/${path}")
		sources = WindowsRuntime.source_records!(root, rust_sources.concat(["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "ci/zig_msvc_cc.roc"]))?
		repository = Env.var_str!(OsStr.from_str("GITHUB_REPOSITORY")) ?? "niclas-ahden/joy-cli-platform"
		host = Object([
			("component", Text("joy-cli-platform Rust MSVC static host and its embedded dependencies")),
			("source_url", Text("https://github.com/${repository}")),
			("source_revision", Text(Process.capture!(["git", "rev-parse", "HEAD"])?)),
			("sources", sources),
			("license", Text("UPL-1.0 and the individual Cargo/Rust component licenses")),
			("license_files", JsonValue.texts(Files.unique_sorted($license_files))),
			("redistribution_basis", Text("Original permissive source-package licenses and Rust's component copyright and license document are included. No Microsoft CRT or SDK archives are incorporated.")),
			("build_commands", Array(build_commands.map(JsonValue.texts))),
			("modifications", Array([])),
			("toolchain", Object(toolchain.map(|(key, value)| (key, Text(value))))),
			("rust_version", Text(Process.capture!(["rustc", "-vV"])?)),
			("packages", Array($packages)),
		])
		manifest = WindowsRuntime.read_manifest!(output)?
		components = JsonValue.fields_of(JsonValue.field(manifest, "components") ?? Null).drop_if(|(id, _)| id == "host").append(("host", host))
		library_components = JsonValue.fields_of(JsonValue.field(manifest, "libraries") ?? Null)
			.drop_if(|(name, _)| name == "host.lib")
			.map(|(name, record)| (name, JsonValue.text_of(JsonValue.field(record, "component") ?? Null) ?? ""))
			.append(("host.lib", "host"))
		WindowsRuntime.write_manifest!(output, components, library_components)?
		_ = WindowsRuntime.validate!(output, True)?
		Ok({})
	}

	## Prints the name of a check, runs it, and prints that it passed.
	check! : Str, (() => Try({}, [Failed(Str), CommandFailed(Str, I32)])) => Try({}, [Failed(Str), CommandFailed(Str, I32)])
	check! = |name, test!| {
		Stdout.line!("Checking ${name}...") ?? {}
		test!()?
		Stdout.line!("ok: ${name}") ?? {}
		Ok({})
	}

	# Checking

	## A file of an input folder: its path there, size and hash, and whether
	## it is inside the folder once its links are resolved.
	FileInfo : { path : Str, size : U64, sha256 : Str, inside : Bool }

	## Checks an input folder's PROVENANCE.json against its files, and returns
	## the paths in it of the manifest and of every license file it records.
	## Without `require_host`, `host.lib` is not expected.
	validate! : Str, Bool => Try(List(Str), [Failed(Str)])
	validate! = |output, require_host| {
		manifest = WindowsRuntime.read_manifest!(output)?
		real_output = Files.posix(Files.canonical!(output)?)
		files = Files.files_under!(output)?.fold_try!(
			[],
			|all, path| {
				full = "${output}/${path}"
				inside = Files.posix(Files.canonical!(full)?).starts_with("${real_output}/")
				Ok(all.append({ path, size: Files.size!(full), sha256: Files.sha256!(full)?, inside }))
			},
		)?
		WindowsRuntime.check_provenance(manifest, files, require_host)
	}

	check_provenance : JsonValue, List(WindowsRuntime.FileInfo), Bool -> Try(List(Str), [Failed(Str)])
	check_provenance = |manifest, files, require_host| {
		format_ok =
			match JsonValue.field(manifest, "format_version") {
				Ok(Number("1")) => True
				_ => False
			}
		if !format_ok {
			return Err(Failed("Unsupported Windows provenance format"))
		}
		records = JsonValue.fields_of(JsonValue.field(manifest, "libraries") ?? Null)
		expected = (if (require_host) WindowsRuntime.libraries.append("host.lib") else WindowsRuntime.libraries).sort_with(Files.compare)
		binaries = files.keep_if(|file| WindowsRuntime.is_binary(file.path) and (require_host or file.path != "host.lib"))
		inventory = binaries.map(|file| file.path).sort_with(Files.compare)
		empty = binaries.keep_if(|file| file.size == 0).map(|file| file.path)
		if inventory != expected or !empty.is_empty() or records.map(|(name, _)| name).sort_with(Files.compare) != expected {
			return Err(Failed("Windows library inventory mismatch: expected ${Str.join_with(expected, ", ")}, found ${Str.join_with(inventory, ", ")}, empty ${Str.join_with(empty, ", ")}"))
		}
		components = JsonValue.field(manifest, "components") ?? Null
		documents = JsonValue.field(manifest, "documents") ?? Null
		var $found = [WindowsRuntime.manifest_name]
		for (name, record) in records {
			same =
				match (JsonValue.text_of(JsonValue.field(record, "sha256") ?? Null), files.find_first(|file| file.path == name)) {
					(Ok(sha256), Ok(file)) => sha256 == file.sha256
					_ => False
				}
			if !same {
				return Err(Failed("Windows library hash mismatch: ${name}"))
			}
			var $pending = [JsonValue.text_of(JsonValue.field(record, "component") ?? Null) ?? ""]
			var $checked = []
			while !$pending.is_empty() {
				id = $pending.last() ?? ""
				$pending = $pending.drop_last(1)
				if !$checked.contains(id) {
					$checked = $checked.append(id)
					component = JsonValue.field(components, id) ? |_| Failed("Missing Windows component ${id}")
					$pending = $pending.concat(JsonValue.items_of(JsonValue.field(component, "subcomponents") ?? Null).keep_oks(JsonValue.text_of))
					$found = $found.concat(WindowsRuntime.check_component(documents, id, component, files)?)
				}
			}
		}
		Ok(Files.unique_sorted($found))
	}

	## Refuses a component without its rights evidence, or with a license
	## file that is missing, empty, outside the folder or changed.
	check_component : JsonValue, Str, JsonValue, List(WindowsRuntime.FileInfo) -> Try(List(Str), [Failed(Str)])
	check_component = |documents, id, component, files| {
		for key in ["license", "license_files", "redistribution_basis", "sources", "build_commands"] {
			given =
				match JsonValue.field(component, key) {
					Ok(Text(text)) => !text.is_empty()
					Ok(Array(items)) => !items.is_empty()
					_ => False
				}
			if !given {
				return Err(Failed("Missing ${key} for Windows component ${id}"))
			}
		}
		JsonValue.items_of(JsonValue.field(component, "license_files") ?? Null).fold_try(
			[],
			|found, item| {
				relative = JsonValue.text_of(item) ?? ""
				invalid = Failed("Missing or invalid Windows license file: ${relative}")
				path = WindowsRuntime.within(relative) ? |_| invalid
				file = files.find_first(|f| f.path == path) ? |_| invalid
				if file.size == 0 or !file.inside {
					return Err(invalid)
				}
				if JsonValue.text_of(JsonValue.field(documents, relative) ?? Null) != Ok(file.sha256) {
					return Err(Failed("Windows license hash mismatch: ${relative}"))
				}
				Ok(found.append(path))
			},
		)
	}
}

# Tests. They run through an app that imports this module:
# `roc test scripts/windows_runtime.roc`.

fixture_files : List(WindowsRuntime.FileInfo)
fixture_files = [
	{ path: "windows_support.lib", size: 19, sha256: "aa", inside: True },
	{ path: "host.lib", size: 8, sha256: "bb", inside: True },
	{ path: "licenses/license.txt", size: 16, sha256: "cc", inside: True },
	{ path: "PROVENANCE.json", size: 100, sha256: "dd", inside: True },
]

fixture_component : List((Str, JsonValue))
fixture_component = [
	("license", Text("MIT")),
	("license_files", Array([Text("licenses/license.txt")])),
	("redistribution_basis", Text("fixture")),
	("sources", Array([Object([("sha256", Text("fixture"))])])),
	("build_commands", Array([Array([Text("fixture")])])),
]

check_fixture : List((Str, List((Str, JsonValue)))), List(WindowsRuntime.FileInfo) -> Try(List(Str), [Failed(Str)])
check_fixture = |components, files| {
	manifest = WindowsRuntime.manifest_of(components.map(|(id, fields)| (id, Object(fields))), [("windows_support.lib", "fixture", "aa"), ("host.lib", "fixture", "bb")], [("licenses/license.txt", "cc")])
	WindowsRuntime.check_provenance(manifest, files, True)
}

failure_of : Try(List(Str), [Failed(Str)]) -> Str
failure_of = |result|
	match result {
		Ok(_) => ""
		Err(Failed(message)) => message
	}

with_files : List(WindowsRuntime.FileInfo), Str, (WindowsRuntime.FileInfo -> WindowsRuntime.FileInfo) -> List(WindowsRuntime.FileInfo)
with_files = |files, path, change| files.map(|f| if (f.path == path) change(f) else f)

# A complete inventory returns the manifest and the notice.
expect check_fixture([("fixture", fixture_component)], fixture_files) == Ok(["PROVENANCE.json", "licenses/license.txt"])

# A changed library is refused.
expect failure_of(check_fixture([("fixture", fixture_component)], with_files(fixture_files, "host.lib", |f| { ..f, sha256: "changed" }))).contains("library hash mismatch")

# A changed notice is refused.
expect failure_of(check_fixture([("fixture", fixture_component)], with_files(fixture_files, "licenses/license.txt", |f| { ..f, sha256: "changed" }))).contains("license hash mismatch")

# An empty input is refused.
expect failure_of(check_fixture([("fixture", fixture_component)], with_files(fixture_files, "windows_support.lib", |f| { ..f, size: 0 }))).contains("inventory mismatch")

# Every unrecorded binary input is refused, empty or not, at any depth and in
# any case: an SDK archive nobody recorded, an object file.
expect
	["libcmt.lib", "startup.obj", "startup.o", "extra.a", "EXTRA.LIB", "nested/startup.OBJ", "licenses/extra.a"].all(
		|path|
			[0, 10].all(|size| failure_of(check_fixture([("fixture", fixture_component)], fixture_files.append({ path, size, sha256: "ee", inside: True }))).contains("inventory mismatch")),
	)

# A license file outside the folder is refused, by its path or through a link.
expect failure_of(check_fixture([("fixture", fixture_component.drop_if(|(key, _)| key == "license_files").append(("license_files", Array([Text("../outside.txt")]))))], fixture_files)).contains("invalid Windows license")
expect failure_of(check_fixture([("fixture", fixture_component)], with_files(fixture_files, "licenses/license.txt", |f| { ..f, inside: False }))).contains("invalid Windows license")
expect WindowsRuntime.within("a/./b/../c") == Ok("a/c") and WindowsRuntime.within("a/../../b") == Err(Escapes) and WindowsRuntime.within("/etc/passwd") == Err(Escapes) and WindowsRuntime.within("C:/x") == Err(Escapes)

# A component without its rights evidence is refused.
expect failure_of(check_fixture([("fixture", fixture_component.drop_if(|(key, _)| key == "redistribution_basis"))], fixture_files)) == "Missing redistribution_basis for Windows component fixture"

# A combined archive still needs every component's rights.
expect failure_of(check_fixture([("fixture", fixture_component.append(("subcomponents", Array([Text("child")])))), ("child", fixture_component.drop_if(|(key, _)| key == "redistribution_basis"))], fixture_files)) == "Missing redistribution_basis for Windows component child"

# Without the host, host.lib is neither expected nor counted.
expect {
	manifest = WindowsRuntime.manifest_of([("fixture", Object(fixture_component))], [("windows_support.lib", "fixture", "aa")], [("licenses/license.txt", "cc")])
	WindowsRuntime.check_provenance(manifest, fixture_files, False) == Ok(["PROVENANCE.json", "licenses/license.txt"])
}

# Stdcall suffixes go, export ordinals stay.
expect {
	definition = WindowsRuntime.normalize_definition("EXPORTS\n Foo@8 @123\n Bar @4 DATA\n Baz@12x\n")
	definition.contains("Foo @123") and definition.contains("Bar @4 DATA") and definition.contains("Baz@12x") and definition.starts_with("; Generated by basic-cli")
}

# zig env's lib_dir.
expect WindowsRuntime.lib_dir_of(".{\n    .zig_exe = \"/z/zig\",\n    .lib_dir = \"C:\\\\zig\\\\lib\",\n}") == Ok("C:\\zig\\lib")
expect WindowsRuntime.lib_dir_of(".{}").is_err()

# The Zig source release is the one Zig builds with.
expect WindowsRuntime.zig_release.source_url == "https://ziglang.org/download/${WindowsRuntime.zig_release.version}/zig-${WindowsRuntime.zig_release.version}.tar.xz"
