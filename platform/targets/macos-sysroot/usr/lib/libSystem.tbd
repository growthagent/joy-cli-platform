--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos, arm64-macos ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1351
exports:
  - targets:         [ x86_64-macos, arm64-macos ]
    symbols:         [ _CCRandomGenerateBytes, __NSGetEnviron,
                       __NSGetExecutablePath, __Unwind_Backtrace,
                       __Unwind_GetDataRelBase, __Unwind_GetIP,
                       __Unwind_GetIPInfo,
                       __Unwind_GetLanguageSpecificData,
                       __Unwind_GetRegionStart, __Unwind_GetTextRelBase,
                       __Unwind_Resume, __Unwind_SetGR, __Unwind_SetIP,
                       ___assert_rtn, ___error, ___stack_chk_fail,
                       ___stack_chk_guard, ___umodti3,
                       __dyld_get_image_header, __dyld_get_image_name,
                       __dyld_get_image_vmaddr_slide, __dyld_image_count,
                       __exit, __tlv_atexit, __tlv_bootstrap, _abort,
                       _accept, _acl_add_flag_np, _acl_free,
                       _acl_get_entry, _acl_get_fd, _acl_get_flagset_np,
                       _acl_init, _bind, _calloc, _cfmakeraw, _chdir,
                       _chmod, _chroot, _clock_gettime, _closedir,
                       _confstr, _connect, _copyfile_state_alloc,
                       _copyfile_state_free, _copyfile_state_get, _dirfd,
                       _dispatch_release, _dispatch_semaphore_create,
                       _dispatch_semaphore_signal,
                       _dispatch_semaphore_wait, _dispatch_time, _dlsym,
                       _dup2, _execv, _execvp, _exit, _fchmod,
                       _fchmodx_np, _fclonefileat, _fcntl, _fcopyfile,
                       _filesec_free, _filesec_init,
                       _filesec_set_property, _fork, _free,
                       _freeaddrinfo, _ftruncate, _gai_strerror,
                       _getaddrinfo, _getcwd, _getentropy, _getenv,
                       _getpeername, _getpgrp, _getpid, _getrlimit,
                       _getsockname, _getsockopt, _if_nametoindex,
                       _ioctl, _isatty, _kevent, _kill, _killpg, _kqueue,
                       _linkat, _listen, _lseek, _malloc, _memcmp,
                       _memcpy, _memmove, _memset, _mkdir, _mmap,
                       _mprotect, _munmap, _nanosleep, _open, _openat,
                       _openx_np, _pause, _pipe, _poll, _posix_memalign,
                       _posix_spawn_file_actions_adddup2,
                       _posix_spawn_file_actions_destroy,
                       _posix_spawn_file_actions_init,
                       _posix_spawnattr_destroy, _posix_spawnattr_init,
                       _posix_spawnattr_setflags,
                       _posix_spawnattr_setpgroup,
                       _posix_spawnattr_setsigdefault, _posix_spawnp,
                       _pthread_attr_destroy, _pthread_attr_init,
                       _pthread_attr_setstacksize,
                       _pthread_cond_broadcast, _pthread_cond_destroy,
                       _pthread_cond_signal,
                       _pthread_cond_timedwait_relative_np,
                       _pthread_cond_wait, _pthread_create,
                       _pthread_detach, _pthread_join, _pthread_kill,
                       _pthread_mutex_destroy, _pthread_mutex_init,
                       _pthread_mutex_lock, _pthread_mutex_trylock,
                       _pthread_mutex_unlock, _pthread_mutexattr_destroy,
                       _pthread_mutexattr_init,
                       _pthread_mutexattr_settype, _pthread_self,
                       _pthread_setname_np, _pthread_sigmask,
                       _pthread_threadid_np, _raise, _read, _readlink,
                       _readlinkat, _realloc, '_realpath$DARWIN_EXTSN',
                       _recv, _rename, _rmdir, _sched_yield, _send,
                       _setgid, _setgroups, _setpgid, _setsid,
                       _setsockopt, _setuid, _shutdown, _sigaction,
                       _sigaddset, _sigemptyset, _sigfillset, _signal,
                       _sigprocmask, _socket, _socketpair, _strerror_r,
                       _strlen, _symlink, _sysconf, _tcgetattr,
                       _tcsetattr, _unlink, _unlinkat, _waitpid, _write,
                       _writev, dyld_stub_binder ]
  - targets:         [ arm64-macos ]
    symbols:         [ _bzero, _close, _fdopendir, _fstat, _fstatat,
                       _lstat, _opendir, _readdir_r, _stat,
                       _sysctlbyname ]
  - targets:         [ x86_64-macos ]
    symbols:         [ ___bzero, '_close$NOCANCEL', '_fdopendir$INODE64',
                       '_fstat$INODE64', '_fstatat$INODE64',
                       '_lstat$INODE64', '_opendir$INODE64',
                       '_readdir_r$INODE64', '_stat$INODE64' ]
...
